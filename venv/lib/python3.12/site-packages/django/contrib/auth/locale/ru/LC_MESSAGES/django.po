#: venv/lib/python3.12/site-packages/django/contrib/auth/admin.py:46
msgid "Personal info"
msgstr "Персональная информация"

#: venv/lib/python3.12/site-packages/django/contrib/auth/admin.py:48
msgid "Permissions"
msgstr "Права доступа"

#: venv/lib/python3.12/site-packages/django/contrib/auth/admin.py:59
msgid "Important dates"
msgstr "Важные даты"

#: venv/lib/python3.12/site-packages/django/contrib/auth/admin.py:156
#, python-format
msgid "%(name)s object with primary key %(key)r does not exist."
msgstr "%(name)s с первичным ключом %(key)r не существует."

#: venv/lib/python3.12/site-packages/django/contrib/auth/admin.py:175
msgid "Conflicting form data submitted. Please try again."
msgstr ""
"Отправлены взаимоисключающие данные. Измените данные и попробуйте снова."

#: venv/lib/python3.12/site-packages/django/contrib/auth/admin.py:183
msgid "Password changed successfully."
msgstr "Пароль успешно изменен."

#: venv/lib/python3.12/site-packages/django/contrib/auth/admin.py:185
msgid "Password-based authentication was disabled."
msgstr "Аутентификация по паролю была запрещена."

#: venv/lib/python3.12/site-packages/django/contrib/auth/admin.py:206
#, python-format
msgid "Change password: %s"
msgstr "Изменить пароль: %s"

#: venv/lib/python3.12/site-packages/django/contrib/auth/admin.py:208
#, python-format
msgid "Set password: %s"
msgstr "Задать пароль: %s"

#: venv/lib/python3.12/site-packages/django/contrib/auth/apps.py:16
msgid "Authentication and Authorization"
msgstr "Пользователи и группы"

#: venv/lib/python3.12/site-packages/django/contrib/auth/base_user.py:44
msgid "password"
msgstr "пароль"

#: venv/lib/python3.12/site-packages/django/contrib/auth/base_user.py:45
msgid "last login"
msgstr "последний вход"

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:42
msgid "Reset password"
msgstr "Сбросить пароль"

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:42
msgid "Set password"
msgstr "Задать пароль"

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:85
msgid "The two password fields didn’t match."
msgstr "Введенные пароли не совпадают."

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:89
#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:277
#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:313
msgid "Password"
msgstr "Пароль"

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:89
msgid "Password confirmation"
msgstr "Подтверждение пароля"

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:102
msgid "Enter the same password as before, for verification."
msgstr "Для подтверждения введите, пожалуйста, пароль ещё раз."

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:149
msgid ""
"Whether the user will be able to authenticate using a password or not. If "
"disabled, they may still be able to authenticate using other backends, such "
"as Single Sign-On or LDAP."
msgstr ""
"Может ли пользователь аутентифироваться по паролю. Если эта возможность "
"выключена, пользователь всё ещё может аутентифицироваться иными способами, "
"например, Single Sing-On или LDAP, если они сконфигурированы и разрешены."

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:157
msgid "Password-based authentication"
msgstr "Аутентификация по паролю"

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:160
msgid "Enabled"
msgstr "Разрешена"

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:160
msgid "Disabled"
msgstr "Запрещена"

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:279
msgid ""
"Raw passwords are not stored, so there is no way to see the user’s password."
msgstr ""
"Мы не храним сырые пароли, поэтому не существует способа посмотреть пароль "
"пользователя."

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:295
msgid ""
"Enable password-based authentication for this user by setting a password."
msgstr ""
"Разрешить аутентификацию по паролю для этого пользователя, задав его пароль."

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:320
#, python-format
msgid ""
"Please enter a correct %(username)s and password. Note that both fields may "
"be case-sensitive."
msgstr ""
"Пожалуйста, введите правильные %(username)s и пароль. Оба поля могут быть "
"чувствительны к регистру."

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:323
msgid "This account is inactive."
msgstr "Эта учетная запись отключена."

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:389
msgid "Email"
msgstr "Адрес электронной почты"

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:498
msgid "New password"
msgstr "Новый пароль"

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:498
msgid "New password confirmation"
msgstr "Подтверждение нового пароля"

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:523
msgid "Your old password was entered incorrectly. Please enter it again."
msgstr "Ваш старый пароль введен неправильно. Пожалуйста, введите его снова."

#: venv/lib/python3.12/site-packages/django/contrib/auth/forms.py:527
msgid "Old password"
msgstr "Старый пароль"

