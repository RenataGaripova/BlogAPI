msgid "permission"
msgstr "право"

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:75
#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:123
msgid "permissions"
msgstr "права"

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:130
msgid "group"
msgstr "группа"

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:131
#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:333
msgid "groups"
msgstr "группы"

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:324
msgid "superuser status"
msgstr "статус суперпользователя"

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:327
msgid ""
"Designates that this user has all permissions without explicitly assigning "
"them."
msgstr "Указывает, что пользователь имеет все права без явного их назначения."

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:336
msgid ""
"The groups this user belongs to. A user will get all permissions granted to "
"each of their groups."
msgstr ""
"Группы, к которым принадлежит данный пользователь. Пользователь получит все "
"права, указанные в каждой из его/её групп."

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:344
msgid "user permissions"
msgstr "права пользователя"

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:346
msgid "Specific permissions for this user."
msgstr "Индивидуальные права данного пользователя."

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:457
msgid "username"
msgstr "имя пользователя"

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:461
msgid "Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only."
msgstr ""
"Обязательное поле. Не более 150 символов. Только буквы, цифры и символы @/./"
"+/-/_."

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:465
msgid "A user with that username already exists."
msgstr "Пользователь с таким именем уже существует."

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:468
msgid "first name"
msgstr "имя"

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:469
msgid "last name"
msgstr "фамилия"

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:470
msgid "email address"
msgstr "адрес электронной почты"

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:472
msgid "staff status"
msgstr "статус персонала"

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:474
msgid "Designates whether the user can log into this admin site."
msgstr ""
"Отметьте, если пользователь может входить в административную часть сайта."

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:477
msgid "active"
msgstr "активный"

#: venv/lib/python3.12/site-packages/django/contrib/auth/models.py:480
